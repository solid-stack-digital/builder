{
  "$ref": "#/definitions/MeshConfig",
  "definitions": {
    "MeshConfig": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "services": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Relative path to service directory containing build.json"
              },
              "port": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "Public host port mapped to internal port 3000"
              },
              "preservePort": {
                "type": "boolean",
                "description": "If true, use the port declared in build.json"
              },
              "provideDependency": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Map consumer dependency key to fellow mesh service provider"
              },
              "replaceMocks": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Alias for provideDependency"
              },
              "envOverrides": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variable overrides with URL templating"
              },
              "healthcheck": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "tcp"
                      },
                      "port": {
                        "type": [
                          "number",
                          "string"
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "test": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      },
                      "interval": {
                        "type": "string"
                      },
                      "timeout": {
                        "type": "string"
                      },
                      "retries": {
                        "type": "number"
                      },
                      "start_period": {
                        "type": "string"
                      },
                      "disable": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "test"
                    ],
                    "additionalProperties": true
                  }
                ]
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "service": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        },
        "tester": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Relative path to E2E tester directory"
            },
            "compose": {
              "type": "string",
              "description": "Tester compose file (defaults to 'docker-compose.yml')"
            },
            "dockerfile": {
              "type": "string",
              "description": "Tester Dockerfile (defaults to 'Dockerfile')"
            },
            "envOverrides": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Environment variable overrides for global tester with URL templating"
            },
            "policy": {
              "type": "object",
              "properties": {
                "dockerfile": {
                  "type": "string"
                },
                "compose": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "services"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
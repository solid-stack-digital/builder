{
  "name": "@solid-stack/builder",
  "version": "1.1.8",
  "description": "CLI build tool and orchestrator for Solid Stack services.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "builder": "./dist/bin.js",
    "solid-builder": "./dist/bin.js"
  },
  "packageManager": "pnpm@11.18.0",
  "files": [
    "dist",
    "templates",
    "schemas"
  ],
  "scripts": {
    "build:schemas": "tsx scripts/generate-schemas.ts",
    "build": "pnpm build:schemas && tsx scripts/build.ts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm build && pnpm test && tsx scripts/prepublish-check.ts"
  },
  "keywords": [
    "solid-stack",
    "builder",
    "cli",
    "docker",
    "orchestrator",
    "compose",
    "typescript",
    "esm"
  ],
  "author": "Solid Stack Digital",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.1.2",
    "tsc-alias": "^1.9.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod-to-json-schema": "^3.25.2"
  }
}

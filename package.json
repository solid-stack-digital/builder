{
  "name": "@solid-stack/builder",
  "version": "1.0.4",
  "description": "CLI build tool and orchestrator for Solid Stack services.",
  "type": "module",
  "bin": {
    "builder": "./dist/bin.js",
    "solid-builder": "./dist/bin.js"
  },
  "packageManager": "pnpm@11.18.0",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json --outDir dist && tsc-alias -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm build && pnpm test && tsx scripts/prepublish-check.ts"
  },
  "keywords": [
    "solid-stack",
    "builder",
    "cli",
    "docker",
    "orchestrator",
    "compose",
    "typescript",
    "esm",
    "cjs"
  ],
  "author": "Solid Stack Digital",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/yaml": "^1.9.7",
    "tsc-alias": "^1.9.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

{
  "name": "fullstack",
  "services": {
    "filesystem": {
      "path": "./services/filesystem"
    },
    "mailer": {
      "path": "./services/mailer"
    },
    "backend": {
      "path": "./services/backend",
      "provideDependency": {
        "filesystem": "filesystem",
        "mailer": "mailer"
      },
      "envOverrides": {
        "FILESYSTEM_URL": "${filesystem.network_url}",
        "MAILER_URL": "${mailer.network_url}"
      }
    },
    "frontend": {
      "path": "./services/frontend",
      "provideDependency": {
        "backend": "backend"
      },
      "envOverrides": {
        "BACKEND_URL": "${gateway.public_url}/api"
      }
    },
    "gateway": {
      "path": "./services/gateway",
      "port": 3000,
      "provideDependency": {
        "frontend": "frontend",
        "backend": "backend"
      },
      "envOverrides": {
        "FRONTEND_URL": "${frontend.network_url}",
        "BACKEND_URL": "${backend.network_url}"
      }
    }
  },
  "tester": {
    "path": "./e2e"
  }
}

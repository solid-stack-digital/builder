{
  "name": "fullstack",
  "services": {
    "filesystem": {
      "path": "./services/filesystem",
      "publish": [
        "app.endpoints.http"
      ]
    },
    "mailer": {
      "path": "./services/mailer",
      "publish": [
        "app.endpoints.http"
      ]
    },
    "backend": {
      "path": "./services/backend",
      "dependencies": {
        "filesystem": "filesystem",
        "mailer": "mailer"
      },
      "env": {
        "FILESYSTEM_URL": "${filesystem.app.endpoints.http.network_url}",
        "MAILER_URL": "${mailer.app.endpoints.http.network_url}"
      },
      "publish": [
        "app.endpoints.http"
      ]
    },
    "frontend": {
      "path": "./services/frontend",
      "dependencies": {
        "backend": "backend"
      },
      "env": {
        "BACKEND_URL": "${backend.app.endpoints.http.network_url}"
      },
      "publish": [
        "app.endpoints.http"
      ]
    },
    "gateway": {
      "path": "./services/gateway",
      "dependencies": {
        "frontend": "frontend",
        "backend": "backend"
      },
      "env": {
        "FRONTEND_URL": "${frontend.app.endpoints.http.network_url}",
        "BACKEND_URL": "${backend.app.endpoints.http.network_url}"
      },
      "publish": [
        "app.endpoints.http"
      ]
    }
  },
  "tester": {
    "compose": "./e2e/docker-compose.yml",
    "service": "global-e2e",
    "env": {
      "FILESYSTEM_URL": "${filesystem.app.endpoints.http.public_url}",
      "MAILER_URL": "${mailer.app.endpoints.http.public_url}",
      "BACKEND_URL": "${backend.app.endpoints.http.public_url}",
      "FRONTEND_URL": "${frontend.app.endpoints.http.public_url}",
      "GATEWAY_URL": "${gateway.app.endpoints.http.public_url}"
    }
  }
}

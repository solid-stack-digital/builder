{
  "name": "fullstack",
  "services": {
    "tester": {
      "compose": "./e2e/docker-compose.yml",
      "service": "global-e2e",
      "env": {
        "FILESYSTEM_URL": "${filesystem.source.main.endpoints.http.public_url}",
        "MAILER_URL": "${mailer.source.main.endpoints.http.public_url}",
        "BACKEND_URL": "${backend.source.main.endpoints.http.public_url}",
        "FRONTEND_URL": "${frontend.source.main.endpoints.http.public_url}",
        "GATEWAY_URL": "${gateway.source.main.endpoints.http.public_url}"
      }
    },
    "filesystem": {
      "source": "./services/filesystem",
      "publish": [
        "main.endpoints.http"
      ]
    },
    "mailer": {
      "source": "./services/mailer",
      "publish": [
        "main.endpoints.http"
      ]
    },
    "backend": {
      "source": "./services/backend",
      "publish": [
        "main.endpoints.http"
      ],
      "extends": {
        "main": {
          "requisites": {
            "source.filesystem": false,
            "filesystem": "dependency",
            "source.mailer": false,
            "mailer": "dependency"
          },
          "env": {
            "FILESYSTEM_URL": "${filesystem.source.main.endpoints.http.network_url}",
            "MAILER_URL": "${mailer.source.main.endpoints.http.network_url}"
          }
        }
      }
    },
    "frontend": {
      "source": "./services/frontend",
      "publish": [
        "main.endpoints.http"
      ],
      "extends": {
        "main": {
          "requisites": {
            "source.backend": false,
            "backend": "dependency"
          },
          "env": {
            "BACKEND_URL": "${backend.source.main.endpoints.http.network_url}"
          }
        }
      }
    },
    "gateway": {
      "source": "./services/gateway",
      "publish": [
        "main.endpoints.http"
      ],
      "extends": {
        "main": {
          "requisites": {
            "source.frontend": false,
            "frontend": "dependency",
            "source.backend": false,
            "backend": "dependency"
          },
          "env": {
            "FRONTEND_URL": "${frontend.source.main.endpoints.http.network_url}",
            "BACKEND_URL": "${backend.source.main.endpoints.http.network_url}"
          }
        }
      }
    }
  }
}

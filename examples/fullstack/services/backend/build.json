{
  "name": "fullstack-backend",
  "app": {
    "endpoints": {
      "http": {
        "port": 3002,
        "publicPort": "AUTO",
        "primary": true,
        "scheme": "http"
      }
    }
  },
  "dependencies": {
    "filesystem": {
      "compose": ".docker/mocks/docker-compose.filesystem.yml",
      "endpoints": {
        "http": {
          "service": "mock-filesystem",
          "port": 3003,
          "primary": true,
          "scheme": "http"
        }
      }
    },
    "mailer": {
      "compose": ".docker/mocks/docker-compose.mailer.yml",
      "endpoints": {
        "http": {
          "service": "mock-mailer",
          "port": 3004,
          "primary": true,
          "scheme": "http"
        }
      }
    },
    "firebase": {
      "compose": ".docker/mocks/docker-compose.firebase.yml",
      "endpoints": {
        "http": {
          "service": "firebase-emulator",
          "port": 8080,
          "primary": true,
          "scheme": "http"
        }
      }
    }
  },
  "dev": {
    "override-compose": ".docker/overrides/docker-compose.dev.override.yml"
  },
  "test": {
    "override-compose": ".docker/overrides/docker-compose.test.override.yml"
  },
  "prod": {
    "override-compose": ".docker/overrides/docker-compose.prod.override.yml"
  },
  "e2e": {
    "app": {
      "env": {
        "CI": "true"
      }
    }
  },
  "tester": {
    "env": {
      "API_URL": "${app.endpoints.http.public_url}"
    }
  }
}

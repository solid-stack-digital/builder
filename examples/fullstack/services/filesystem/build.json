{
  "name": "fullstack-filesystem",
  "services": {
    "main": {
      "endpoints": {
        "http": {
          "port": 3003,
          "publicPort": "AUTO",
          "primary": true,
          "scheme": "http"
        }
      },
      "requisites": {
        "firebase": "dependency"
      }
    },
    "firebase": {
      "compose": ".docker/mocks/docker-compose.firebase.yml",
      "endpoints": {
        "http": {
          "service": "firebase-emulator",
          "port": 8080,
          "primary": true,
          "scheme": "http"
        }
      }
    },
    "tester": {
      "compose": "e2e/docker-compose.yml",
      "service": "e2e-runner",
      "env": {
        "API_URL": "${main.endpoints.http.public_url}"
      }
    }
  },
  "dev": {
    "services": {
      "main": {
        "override-compose": ".docker/overrides/docker-compose.dev.override.yml"
      }
    }
  },
  "prod": {
    "services": {
      "main": {
        "override-compose": ".docker/overrides/docker-compose.prod.override.yml",
        "env": {
          "FIREBASE_URL": "${firebase.endpoints.http.network_url}"
        }
      }
    }
  },
  "test": {
    "services": {
      "main": {
        "override-compose": ".docker/overrides/docker-compose.test.override.yml"
      }
    }
  },
  "e2e": {
    "services": {
      "main": {
        "env": {
          "CI": "true"
        }
      }
    }
  }
}

{
  "name": "fullstack-gateway",
  "services": {
    "main": {
      "endpoints": {
        "http": {
          "port": 3000,
          "publicPort": "AUTO",
          "primary": true,
          "scheme": "http"
        }
      },
      "requisites": {
        "frontend": "dependency",
        "backend": "dependency"
      }
    },
    "frontend": {
      "compose": ".docker/mocks/docker-compose.frontend.yml",
      "endpoints": {
        "http": {
          "service": "mock-frontend",
          "port": 3001,
          "primary": true,
          "scheme": "http"
        }
      }
    },
    "backend": {
      "compose": ".docker/mocks/docker-compose.backend.yml",
      "endpoints": {
        "http": {
          "service": "mock-backend",
          "port": 3002,
          "primary": true,
          "scheme": "http"
        }
      }
    },
    "tester": {
      "compose": "e2e/docker-compose.yml",
      "service": "e2e-runner",
      "env": {
        "API_URL": "${main.endpoints.http.public_url}"
      }
    }
  },
  "dev": {
    "services": {
      "main": {
        "override-compose": ".docker/overrides/docker-compose.dev.override.yml"
      }
    }
  },
  "prod": {
    "services": {
      "main": {
        "override-compose": ".docker/overrides/docker-compose.prod.override.yml",
        "env": {
          "FRONTEND_URL": "${frontend.endpoints.http.network_url}",
          "BACKEND_URL": "${backend.endpoints.http.network_url}"
        }
      }
    }
  },
  "test": {
    "services": {
      "main": {
        "override-compose": ".docker/overrides/docker-compose.test.override.yml"
      }
    }
  },
  "e2e": {
    "services": {
      "main": {
        "env": {
          "CI": "true"
        }
      }
    }
  }
}

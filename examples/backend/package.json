{
  "name": "example-backend",
  "version": "1.0.0",
  "description": "Example backend service built with Solid Stack builder",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "builder": "builder"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@solid-stack/builder": "link:../..",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

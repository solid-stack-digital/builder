{
  "name": "largeproject",
  "services": {
    "tester": {
      "compose": "./e2e/docker-compose.yml",
      "service": "global-e2e",
      "env": {
        "BACKEND_URL": "${backend.source.main.endpoints.http.public_url}"
      }
    },
    "auth-api": {
      "source": "./services/auth-api"
    },
    "backend": {
      "source": "./services/backend",
      "publish": [
        "main.endpoints.http"
      ],
      "extends": {
        "main": {
          "requisites": {
            "source.auth-api": false,
            "auth-api": "dependency"
          },
          "env": {
            "AUTH_API_URL": "${auth-api.source.main.endpoints.http.network_url}"
          }
        }
      }
    }
  }
}

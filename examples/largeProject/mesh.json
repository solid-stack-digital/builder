{
  "services": {
    "auth-api": {
      "path": "./services/auth-api"
    },
    "backend": {
      "path": "./services/backend",
      "dependencies": {
        "auth-api": "auth-api"
      },
      "env": {
        "AUTH_API_URL": "${auth-api.app.endpoints.http.network_url}"
      },
      "publish": [
        "app.endpoints.http"
      ]
    }
  },
  "tester": {
    "compose": "./e2e/docker-compose.yml",
    "service": "global-e2e",
    "env": {
      "BACKEND_URL": "${backend.app.endpoints.http.public_url}"
    }
  }
}

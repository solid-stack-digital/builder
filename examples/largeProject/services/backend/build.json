{
  "name": "largeproject-backend",
  "services": {
    "main": {
      "endpoints": {
        "http": {
          "port": 3000,
          "publicPort": "AUTO",
          "primary": true,
          "scheme": "http"
        }
      },
      "requisites": {
        "filesystem": "dependency",
        "auth-api": "dependency"
      }
    },
    "filesystem": {
      "compose": ".docker/mocks/docker-compose.filesystem.yml",
      "endpoints": {
        "http": {
          "service": "mock-filesystem",
          "port": 8080,
          "primary": true,
          "scheme": "http"
        }
      }
    },
    "auth-api": {
      "compose": ".docker/mocks/docker-compose.auth-api.yml",
      "endpoints": {
        "http": {
          "service": "mock-auth-api",
          "port": 8080,
          "primary": true,
          "scheme": "http"
        }
      }
    },
    "tester": {
      "compose": "e2e/docker-compose.yml",
      "service": "e2e-runner",
      "env": {
        "API_URL": "${main.endpoints.http.public_url}"
      }
    }
  },
  "dev": {
    "services": {
      "main": {
        "override-compose": ".docker/overrides/docker-compose.dev.override.yml"
      }
    }
  },
  "prod": {
    "services": {
      "main": {
        "override-compose": ".docker/overrides/docker-compose.prod.override.yml",
        "env": {
          "FILESYSTEM_API_URL": "${filesystem.endpoints.http.network_url}",
          "AUTH_API_URL": "${auth-api.endpoints.http.network_url}"
        }
      }
    }
  },
  "test": {
    "services": {
      "main": {
        "override-compose": ".docker/overrides/docker-compose.test.override.yml"
      }
    }
  },
  "e2e": {
    "services": {
      "main": {
        "env": {
          "CI": "true"
        }
      }
    }
  }
}

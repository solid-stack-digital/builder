{
  "name": "mesh-e2e",
  "services": {
    "api": {
      "path": "./app",
      "publish": [
        "app.endpoints.http"
      ],
      "dependencies": {
        "db": "provider"
      }
    },
    "provider": {
      "path": "./provider"
    }
  },
  "tester": {
    "compose": "./tester.yml",
    "service": "runner",
    "env": {
      "API_URL": "${api.app.endpoints.http.public_url}"
    }
  }
}

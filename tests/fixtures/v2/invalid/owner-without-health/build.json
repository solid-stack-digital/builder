{
  "name": "fixture-basic",
  "app": {
    "env": {
      "SELF_URL": "${app.endpoints.http.network_url}"
    },
    "endpoints": {
      "http": {
        "port": 3000,
        "publicPort": "AUTO",
        "primary": true,
        "scheme": "http"
      }
    }
  },
  "tester": {
    "env": {
      "API_URL": "${app.endpoints.http.public_url}"
    }
  },
  "dependencies": {
    "db": {
      "compose": "./db.yml",
      "endpoints": {
        "tcp": {
          "service": "db",
          "port": 6379,
          "primary": true
        }
      }
    }
  }
}

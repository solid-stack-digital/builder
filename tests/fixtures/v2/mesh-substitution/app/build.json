{
  "name": "fixture-service-multidependency",
  "app": {
    "env": {
      "SELF_URL": "${app.endpoints.http.network_url}",
      "ALPHA_HOST": "${dependencies.alpha.endpoints.tcp.network_host}"
    },
    "endpoints": {
      "http": {
        "port": 3000,
        "publicPort": "AUTO",
        "primary": true,
        "scheme": "http"
      }
    }
  },
  "tester": {
    "env": {
      "API_URL": "${app.endpoints.http.public_url}"
    }
  },
  "dependencies": {
    "alpha": {
      "compose": "./alpha.yml",
      "endpoints": {
        "tcp": {
          "service": "alpha",
          "port": 6379,
          "primary": true
        }
      }
    },
    "beta": {
      "compose": "./beta.yml",
      "endpoints": {
        "tcp": {
          "service": "beta",
          "port": 6379,
          "primary": true
        }
      }
    }
  }
}
